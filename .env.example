# Local Vite builds use demo data unless this is true. These two Supabase
# values are intentionally browser-visible and provide authentication only;
# the service-role key below must never use a VITE_ prefix.
VITE_USE_API=false
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Enable only providers configured in Supabase Auth. Email OTP requires SMTP.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_EMAIL_OTP_ENABLED=true

# Server-only values used by the production Docker worker. Never expose the
# service-role key through a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLIC_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional Web Push. Keep this key pair stable across deployments.
VAPID_PUBLIC_KEY=your-base64url-public-key
VAPID_PRIVATE_KEY=your-base64url-private-key
VAPID_SUBJECT=https://delivery.example.com

# Optional native iPhone notifications. These are Apple Developer server
# credentials; keep the complete .p8 private key on the server only. A value
# with literal \n line breaks is accepted by the worker.
APNS_TEAM_ID=your-apple-team-id
APNS_KEY_ID=your-apns-key-id
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-key-material\n-----END PRIVATE KEY-----
APNS_BUNDLE_ID=com.plhery.SwissDeliveryTracker

# Private TRAWL browser endpoint. UPS uses it only when direct HTTP is challenged;
# DPD uses it only as its web fallback. Swiss Delivery Tracker does not need TRAWL's Redis.
FLARESOLVERR_URL=http://flaresolverr:8191

# Advanced DPD client override; normally leave commented and use the adapter's
# pinned public app identifier.
# DPD_FIREBASE_API_KEY=

PORT=3000
STATIC_DIR=/app/dist
MAX_HTTP_WORKERS=64
REQUEST_SOCKET_TIMEOUT=15
