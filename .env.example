# Local Vite builds use demo data unless this is true.
VITE_USE_API=false

# Server-only values used by the production Docker worker. Never expose the
# service-role key through a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Web Push. Keep this key pair stable across deployments.
VAPID_PUBLIC_KEY=your-base64url-public-key
VAPID_PRIVATE_KEY=your-base64url-private-key
VAPID_SUBJECT=https://delivery.example.com

# Optional DPD recipient verification. Must be exactly four digits. It stays
# server-side and unlocks complete scans plus delivery windows when DPD has one.
# DPD_POSTCODE=8000

# Private TRAWL browser endpoint. Required for UPS and used only as DPD's web
# fallback. UPS structured history also needs the same Redis configured in TRAWL.
FLARESOLVERR_URL=http://flaresolverr:8191
TRAWL_REDIS_URL=redis://trawl-redis:6379/0

# Advanced DPD client override; normally leave commented and use the adapter's
# pinned public app identifier.
# DPD_FIREBASE_API_KEY=

PORT=3000
STATIC_DIR=/app/dist
