{
  "name": "swiss-delivery-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An open-source, iPhone-first PWA for following parcel deliveries.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plhery/delivery-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/plhery/delivery-tracker/issues"
  },
  "homepage": "https://github.com/plhery/delivery-tracker#readme",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10"
  },
  "scripts": {
    "contract:generate": "node scripts/generate-api-contract.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:contract": "node scripts/generate-api-contract.mjs --check",
    "test:coverage": "vitest run --coverage",
    "test:pwa": "node scripts/test-pwa-build.mjs",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "lint:frontend": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
